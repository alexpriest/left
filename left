#!/usr/bin/env python3
"""left — how much time is left.

Born from a 2026-08-05 voice memo: the `Left` app's death countdown landed hard
("almost halfway. Which is rude.") and Alex asked for a daily version of it.

Usage:
    left                 one line, the daily reminder
    left --statusline    ultra-compact, for a Claude Code status bar
    left --json          raw numbers
    left --long          the full read, with the adulthood fraction

Config: ~/.config/left/config.json
    {"birthdate": "1989-02-09", "life_expectancy": 81, "adulthood_starts": 18}
"""

from __future__ import annotations

import json
import sys
from datetime import date
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "left" / "config.json"

DEFAULTS = {
    "birthdate": "1989-02-09",
    "life_expectancy": 81,
    "adulthood_starts": 18,
}


def load_config() -> dict:
    cfg = dict(DEFAULTS)
    if CONFIG_PATH.exists():
        try:
            cfg.update(json.loads(CONFIG_PATH.read_text()))
        except (json.JSONDecodeError, OSError) as e:
            print(f"left: bad config at {CONFIG_PATH}: {e}", file=sys.stderr)
    return cfg


def add_years(d: date, years: int) -> date:
    """Same calendar day, N years on. Feb 29 lands on Mar 1 in a common year."""
    try:
        return d.replace(year=d.year + years)
    except ValueError:
        return d.replace(year=d.year + years, month=3, day=1)


def split_span(start: date, end: date) -> tuple[int, int]:
    """Whole years plus leftover days between two dates."""
    years = end.year - start.year
    if add_years(start, years) > end:
        years -= 1
    return years, (end - add_years(start, years)).days


def compute(cfg: dict, today: date | None = None) -> dict:
    today = today or date.today()
    born = date.fromisoformat(cfg["birthdate"])
    end = add_years(born, int(cfg["life_expectancy"]))
    adult = add_years(born, int(cfg["adulthood_starts"]))

    days_left = (end - today).days
    days_lived = (today - born).days
    total_days = (end - born).days

    years_left, days_rem = split_span(today, end)
    age_years, _ = split_span(born, today)

    adult_total = (end - adult).days
    adult_done = (today - adult).days

    return {
        "birthdate": born.isoformat(),
        "expected_end": end.isoformat(),
        "life_expectancy": int(cfg["life_expectancy"]),
        "age_years": age_years,
        "days_left": days_left,
        "years_left": years_left,
        "days_remainder": days_rem,
        "weeks_left": days_left // 7,
        "months_left": round(days_left / 30.44),
        "pct_spent": round(days_lived / total_days * 100, 1),
        "pct_left": round(days_left / total_days * 100, 1),
        "adult_pct_spent": round(adult_done / adult_total * 100, 1),
        "summers_left": days_left // 365,
    }


# Icon policy, statusline only. The daily line reaches iMessage, where none of the font
# reasoning below holds — it stays bare. No emoji anywhere; that's a standing preference.
#
# The statusline glyph is a DIAL: one character that fills as the life does. It is the same
# fill-level language as the Week Shape calendar, and it means the countdown is something
# you notice at a glance rather than a number you have to read.
#
# ⚠️ EXISTENCE IS NOT THE TEST. METRICS ARE. This first shipped U+29D7 ⧗ BLACK HOURGLASS on
# the strength of a cmap scan showing it present on this Mac (3 fonts: Apple Symbols,
# STIXGeneral, STIXTwoMath). It rendered, and sat visibly misaligned, because all three are
# PROPORTIONAL and the terminal is monospace — every draw was a foreign-width fallback.
# Rescanning monospace fonts only: ⧗ is in ZERO of the 42 here. No hourglass exists in any
# monospace font at all.
#
# ⚠️ THE FALLBACK THEORY WAS TESTED AND FAILED. After ⧗ I built a ○◔◑◕● dial, reasoning
# that ○/◑ (absent from JetBrains Mono) would fall back cleanly because Menlo and Andale
# Mono do have them. They did not — ◑ rendered visibly misaligned, same as ⧗. So the rule
# is simpler and stricter than I kept trying to make it: A FALLBACK GLYPH IS A MISALIGNED
# GLYPH. Only use codepoints the terminal's own font actually maps.
#
# (I also wrote "Alex confirmed the row looks even" into the README on the strength of him
# saying "let's try B and see how it looks." That is not confirmation, it's an experiment,
# and turning one into the other is the exact failure mode logged in feedback_critiquing_alex.
# Corrected. Do not record a prediction as a verified result.)
#
# So: Block Elements. All 32 of U+2580–259F are present in JetBrains Mono — zero fallback
# risk, guaranteed metric-native.
#
# ⚠️ THIRD ITERATION, and the failure was not a font problem this time. The first bar used
# eighth-blocks (▏▎▍▌…) for sub-cell precision. At 44.1% that put a ▏ — a ONE-EIGHTH-WIDTH
# sliver — between the filled and empty runs, and at 14pt a sliver does not read as "partial
# fill", it reads as a GAP. The bar looked broken in the middle. Sub-cell precision is the
# wrong idea in a bar this small, however correct the arithmetic.
#
# Whole cells only, and only the two glyphs already proven to render cleanly in Alex's
# terminal: █ (U+2588) and ░ (U+2591). Both were visibly fine in the screenshot that killed
# the sliver version — it was only the character between them that failed.
#
# 8 cells = 9 states. Coarser than the 41 the eighths gave, and that is the trade: a bar
# that always looks like a bar beats one that encodes more and looks broken.
BAR_CELLS = 8


def bar(pct: float, cells: int = BAR_CELLS) -> str:
    """A metric-native progress bar. Whole cells only — no slivers."""
    filled = round(max(0.0, min(100.0, pct)) / 100 * cells)
    return "█" * filled + "░" * (cells - filled)


def fmt_default(s: dict) -> str:
    return (
        f"{s['years_left']}y {s['days_remainder']}d left "
        f"· {s['weeks_left']:,} Saturdays "
        f"· {s['pct_spent']}% spent"
    )


def fmt_statusline(s: dict) -> str:
    return f"{bar(s['pct_spent'])} {s['years_left']}y {s['days_remainder']}d · {s['pct_spent']}%"


def fmt_long(s: dict) -> str:
    return "\n".join(
        [
            f"{s['years_left']} years, {s['days_remainder']} days left "
            f"(to {s['expected_end']}, at {s['life_expectancy']}).",
            f"   {s['days_left']:,} days · {s['weeks_left']:,} weeks · "
            f"{s['summers_left']} more summers.",
            f"   {s['pct_spent']}% of the whole thing is behind you. "
            f"{s['adult_pct_spent']}% of your adult life.",
        ]
    )


def main() -> int:
    args = set(sys.argv[1:])
    s = compute(load_config())
    if "--json" in args:
        print(json.dumps(s, indent=2))
    elif "--statusline" in args:
        print(fmt_statusline(s))
    elif "--long" in args:
        print(fmt_long(s))
    else:
        print(fmt_default(s))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
